#!/bin/sh
# Ralph commit preflight: fast lint (blocking) + a format report (informative), plus loop containment.
# Bypassing this hook is forbidden by AGENTS.md.
set -eu

. "$(dirname "$0")/_resolve"

# Containment in gate.py only runs when RALPH_LOOP is set, and that variable is lost the moment
# anything clears the environment. Ask the detector instead of trusting it: it is fail-closed, so
# containment goes back on unless a human is at an interactive terminal. Humans keep --no-verify.
if harness/agent_detect.sh >/dev/null; then
    RALPH_LOOP=1
    export RALPH_LOOP
fi

exec "$HARNESS" preflight
